# Set default behavior to automatically normalize line endings
* text=auto

# Source code files - use LF and set diff driver
*.cs text eol=lf diff=csharp
*.props text eol=lf
*.targets text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.pdb binary
*.nupkg binary
*.snupkg binary
