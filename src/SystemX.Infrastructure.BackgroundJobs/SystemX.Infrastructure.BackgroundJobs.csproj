<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Background jobs and recurring task scheduling infrastructure for SystemX using Hangfire and Quartz.</Description>
    <PackageTags>$(PackageTags);background-jobs;jobs;scheduling;hangfire;quartz</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.NetCore" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystemX.SharedKernel\SystemX.SharedKernel.csproj" />
    <ProjectReference Include="..\SystemX.Contracts\SystemX.Contracts.csproj" />
    <ProjectReference Include="..\SystemX.Application.Abstractions\SystemX.Application.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>

</Project>
